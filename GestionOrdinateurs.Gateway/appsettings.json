
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "MetadataAddress": "http://keycloak:8080/realms/gestionordinateurs/.well-known/openid-configuration",
    "ValidIssuer": "http://localhost:8180/realms/gestionordinateurs"
  },
  "ReverseProxy": {
    "Routes": {
      "routeOrdinateurs": {
        "ClusterId": "gestionOrdinateurs",
        "CorsPolicy": "AllowBlazorClient",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/Ordinateurs/{**catch-all}"
        }
      },
      "routeReparations": {
        "ClusterId": "gestionOrdinateurs",
        "CorsPolicy": "AllowBlazorClient",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/Reparation/{**catch-all}"
        }
      },
      "routeHistorique": {
        "ClusterId": "gestionOrdinateurs",
        "CorsPolicy": "AllowBlazorClient",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/reparations/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "gestionOrdinateurs": {
        "Destinations": {
          "destination1": {
            "Address": "http://gestionordinateurs-api:5101/"
          }
        }
      }
    }
  }
  
}
