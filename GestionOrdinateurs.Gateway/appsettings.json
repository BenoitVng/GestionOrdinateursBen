
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "routeOrdinateurs": {
        "ClusterId": "gestionOrdinateurs",
        "CorsPolicy": "AllowBlazorClient",
        "Match": {
          "Path": "/api/Ordinateurs/{**catch-all}"
        }
      },
      "routeReparations": {
        "ClusterId": "gestionOrdinateurs",
        "CorsPolicy": "AllowBlazorClient",
        "Match": {
          "Path": "/api/Reparation/{**catch-all}"
        }
      },
      "routeHistorique": {
        "ClusterId": "gestionOrdinateurs",
        "CorsPolicy": "AllowBlazorClient",
        "Match": {
          "Path": "/api/reparations/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "gestionOrdinateurs": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5101/"
          }
        }
      }
    }
  }
}
