@page "/ordinateurs"
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using Blazored.SessionStorage
@inject IHttpClientFactory HttpClientFactory
@inject ISessionStorageService SessionStorage

<h3>Liste des ordinateurs</h3>

<p>@message</p>

<table class="table">
    <thead>
        <tr>
            <th>Nom</th>
            <th>Prix</th>
            <th>Devise</th>
            <th>Vendu</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ordinateur in ordinateurs)
        {
            <tr>
                <td>@ordinateur.Nom</td>
                <td>@ordinateur.Prix</td>
                <td>EUR</td>
                <td>
                    @if (ordinateur.Vendu)
                    {
                        <span>Oui</span>
                    }
                    else
                    {
                        <span>Non</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<OrdinateurAffichage> ordinateurs = new();
    private string message = "";

    protected override async Task OnInitializedAsync()
    {
        var token = await SessionStorage.GetItemAsync<string>("token");
        if (string.IsNullOrEmpty(token))
        {
            message = "Veuillez vous connecter";
            return;
        }
        var client = HttpClientFactory.CreateClient("GestionOrdinateursApi");
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        try
        {
            var response = await client.GetAsync("api/Ordinateurs");
            if (!response.IsSuccessStatusCode)
            {
                message = "Impossible de récupérer les ordinateurs";
                return;
            }
            ordinateurs = await response.Content.ReadFromJsonAsync<List<OrdinateurAffichage>>() ?? new();
        }
        catch (HttpRequestException)
        {
            message = "Impossible de contacter l'API";
        }
    }

    public class OrdinateurAffichage
    {
        public string Nom { get; set; } = "";
        public decimal Prix { get; set; }
        public bool Vendu { get; set; }
    }
}
