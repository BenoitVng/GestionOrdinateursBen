@page "/login"
@using System.Net.Http.Json
@using Blazored.SessionStorage
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory
@inject ISessionStorageService SessionStorage

<h3>Connexion</h3>

<p>Login :</p>
<input @bind="login" placeholder="Entre ton login" />

<p>Mot de passe :</p>
<input type="password" @bind="motDePasse" placeholder="Entre ton mot de passe" />

<button @onclick="Connecter">Se connecter</button>

<p>@message</p>

@code {
    private string login = "";
    private string motDePasse = "";
    private string message = "";

    private async Task Connecter()
    {
        message = ""; // on efface le message de la tentative précédente
        if (string.IsNullOrWhiteSpace(login) || string.IsNullOrWhiteSpace(motDePasse))
        {
            message = "Entrez un login et un mot de passe";
            return;
        }
        var client = HttpClientFactory.CreateClient("AuthentificationApi");
        try
        {
            // TP4 (ancien appel, sans mot de passe) :
            // var response = await client.PostAsJsonAsync("auth/login", new { Login = login });

            // TP6 : authentification via Keycloak (AuthentificationApi -> Keycloak)
            var response = await client.PostAsJsonAsync("auth/login-keycloak", new { Username = login, Password = motDePasse });
            if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                message = "Login ou mot de passe incorrect";
                return;
            }
            if (!response.IsSuccessStatusCode)
            {
                message = "Erreur lors de la connexion"; // erreur de communication avec l'API ou Keycloak
                return;
            }
            var resultat = await response.Content.ReadFromJsonAsync<LoginResponse>();
            if (resultat == null || string.IsNullOrEmpty(resultat.Token))
            {
                message = "Erreur : token introuvable";
                return;
            }
            await SessionStorage.SetItemAsync("token", resultat.Token); // token Keycloak, utilisé par les autres pages
            Navigation.NavigateTo("/");
        }
        catch (HttpRequestException)
        {
            message = "Impossible de contacter l'API";
        }
    }

    public class LoginResponse
    {
        public string Token { get; set; } = "";
    }
}
