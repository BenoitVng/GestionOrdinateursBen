
@page "/reparations"
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using Blazored.SessionStorage
@inject IHttpClientFactory HttpClientFactory
@inject ISessionStorageService SessionStorage

<h3>Historique des réparations</h3>

<p>@message</p>

<table class="table">
    <thead>
        <tr>
            <th>Ordinateur</th>
            <th>Technicien</th>
            <th>Réparation</th>
            <th>Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var reparation in reparations)
        {
            <tr>
                <td>@reparation.NomOrdinateur</td>
                <td>@reparation.Technicien</td>
                <td>@reparation.TypeReparation</td>
                <td>@reparation.DateIntervention.ToString("dd/MM/yyyy")</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<HistoriqueReparationAffichage> reparations = new();
    private string message = "";

    protected override async Task OnInitializedAsync()
    {
        var token = await SessionStorage.GetItemAsync<string>("token");
        if (string.IsNullOrEmpty(token))
        {
            message = "Veuillez vous connecter";
            return;
        }
        var client = HttpClientFactory.CreateClient("GestionOrdinateursApi");
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        try
        {
            var response = await client.GetAsync("api/reparations/historique");
            if (!response.IsSuccessStatusCode)
            {
                message = "Impossible de récupérer les réparations";
                return;
            }
            reparations = await response.Content.ReadFromJsonAsync<List<HistoriqueReparationAffichage>>() ?? new();
        }
        catch (HttpRequestException)
        {
            message = "Impossible de contacter l'API";
        }
    }

    public class HistoriqueReparationAffichage
    {
        public int OrdinateurId { get; set; }
        public string NomOrdinateur { get; set; } = "";
        public string Technicien { get; set; } = "";
        public string TypeReparation { get; set; } = "";
        public DateTime DateIntervention { get; set; }
    }
}
